{
    "label": "video/vp9-webm",
    "extension": "webm",
    "browser_playable": true,
    "requires_even_dims": true,
    "metadata": "ffmpeg_mkv",
    "video_args": [
        "-c:v", "libvpx-vp9",
        "-pix_fmt", "{pix_fmt}",
        "-crf", "{crf}",
        "-b:v", "0",
        "-g", "1", "-keyint_min", "1",
        "-row-mt", "1",
        "-vf", "scale=out_color_matrix=bt709",
        "-color_range", "tv", "-colorspace", "bt709",
        "-color_primaries", "bt709", "-color_trc", "bt709"
    ],
    "audio_args": ["-c:a", "libopus"],
    "widgets": {
        "crf":     {"type": "INT",   "default": 30, "min": 0, "max": 63, "label": "Quality (CRF, lower=better)"},
        "pix_fmt": {"type": "COMBO", "default": "yuv420p", "label": "Pixel format", "hidden": true,
                    "options": ["yuv420p", "yuva420p", "yuv420p10le", "yuv420p12le"]},
        "alpha":   {"type": "BOOLEAN", "default": false, "label": "Alpha channel (8-bit only)"},
        "bit_depth": {"type": "COMBO", "default": "8", "label": "Bit depth",
                    "options": ["8", "10", "12"]}
    },
    "derived": {
        "pix_fmt": {
            "from": ["alpha", "bit_depth"],
            "default": "yuv420p",
            "map": {
                "false|8":  "yuv420p",
                "false|10": "yuv420p10le",
                "false|12": "yuv420p12le",
                "true|8":   "yuva420p",
                "true|10":  "yuva420p",
                "true|12":  "yuva420p"
            }
        }
    }
}
