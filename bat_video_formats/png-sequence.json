{
    "label": "image/png-sequence",
    "extension": "%05d.png",
    "browser_playable": false,
    "input_color_depth": "16bit",
    "metadata": "png_text",
    "video_args": [
        "-pix_fmt", "{pix_fmt}"
    ],
    "audio_args": null,
    "widgets": {
        "pix_fmt": {"type": "COMBO", "default": "rgb48be", "label": "Pixel format",
                    "options": ["rgb48be", "rgba64be", "rgb24", "rgba"]}
    }
}
