{
    "label": "video/h264-mp4",
    "extension": "mp4",
    "browser_playable": true,
    "requires_even_dims": true,
    "metadata": "ffmpeg_mov",
    "video_args": [
        "-c:v", "libx264",
        "-pix_fmt", "{pix_fmt}",
        "-crf", "{crf}",
        "-preset", "{preset}",
        "-g", "1", "-keyint_min", "1", "-x264-params", "scenecut=0:bframes=0",
        "-vf", "scale=out_color_matrix=bt709",
        "-color_range", "tv",
        "-colorspace", "bt709",
        "-color_primaries", "bt709",
        "-color_trc", "bt709",
        "-movflags", "+faststart"
    ],
    "audio_args": ["-c:a", "aac"],
    "widgets": {
        "crf":     {"type": "INT",   "default": 16, "min": 0, "max": 51, "label": "Quality (CRF, lower=better)"},
        "pix_fmt": {"type": "COMBO", "default": "yuv420p", "label": "Pixel format", "hidden": true,
                    "options": ["yuv420p", "yuv420p10le"]},
        "preset":  {"type": "COMBO", "default": "fast", "label": "Encode preset",
                    "options": ["ultrafast", "superfast", "veryfast", "faster", "fast", "medium", "slow", "slower", "veryslow"]},
        "bit_depth": {"type": "COMBO", "default": "8", "label": "Bit depth (10 = High10, limited HW decode)",
                    "options": ["8", "10"]}
    },
    "derived": {
        "pix_fmt": {
            "from": "bit_depth",
            "default": "yuv420p",
            "map": {
                "8":  "yuv420p",
                "10": "yuv420p10le"
            }
        }
    }
}
